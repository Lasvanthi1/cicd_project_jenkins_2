pipeline {

    agent any

    environment {
        SONAR_HOME = tool "Sonar"
    }

    stages {


        stage("SonarQube Analysis") {
            steps {
                withSonarQubeEnv("SonarQube") {
                    sh '''
                        $SONAR_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=nodetodo \
                        -Dsonar.projectKey=nodetodo \
                        -Dsonar.sources=. \
                        -Dsonar.exclusions=node_modules/**
                    '''
                }
            }
        }

        stage("SonarQube Quality Gates") {
            steps {
                timeout(time: 5, unit: "MINUTES") {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage("Build & Test") {
            steps {
                sh 'docker build -t node-app-batch-6:latest .'
                echo "Code Built Successfully"
            }
        }

        stage("Push to Private Docker Hub Repo") {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "DockerHubCreds",
                        passwordVariable: "dockerPass",
                        usernameVariable: "dockerUser"
                    )
                ]) {
                    sh "docker login -u ${env.dockerUser} -p ${env.dockerPass}"
                    sh "docker tag node-app-batch-6:latest ${env.dockerUser}/node-app-batch-6:latest"
                    sh "docker push ${env.dockerUser}/node-app-batch-6:latest"
                }
            }
        }

        stage("Deploy") {
            steps {
                sh "docker compose down && docker compose up -d"
                echo "App Deployed Successfully"
            }
        }
    }
}
